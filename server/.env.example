# Server Port Configuration
PORT=5000

# Environment Mode (development / production / test)
NODE_ENV=development

# Allowed CORS Origins
CORS_ORIGIN=*

# Sarvam AI API Key (Required for voice speech-to-text / translation)
SARVAM_API_KEY=your_sarvam_api_key_here

# Mistral AI API Key(s) (Required for embedding generation and main LLM response)
# You can define a single primary key:
MISTRAL_API_KEY=your_primary_mistral_key_here

# Optional: To use the round-robin orchestration pool for retry fallback,
# you can define multiple keys using number suffixes:
# MISTRAL_API_KEY1=key_1
# MISTRAL_API_KEY2=key_2
# MISTRAL_API_KEY3=key_3

# Path to the compiled vector index and metadata DB folder.
# By default, the server auto-discovers this to run out-of-the-box:
# - Dev (local): resolves to "../indexing/indexes"
# - Prod (Docker): resolves to "./indexes"
# If you want to override this path manually, uncomment and set the line below:
# INDEX_ROOT=/path/to/indexes
